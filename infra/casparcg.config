<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <paths>
    <media-path>media/</media-path>
    <log-path>log/</log-path>
    <data-path>data/</data-path>
    <template-path>template/</template-path>
  </paths>

  <lock-clear-phrase>secret</lock-clear-phrase>

  <channels>
    <!-- Channel 1: Primary Broadcast Channel with NDI Playout Output -->
    <channel>
      <video-mode>1080p5000</video-mode>
      <consumers>
        <screen>
          <device>1</device>
          <windowed>true</windowed>
          <key-only>false</key-only>
        </screen>
        <!-- NDI Consumer outputting to local network for OBS/vMix/Tricaster -->
        <ndi>
          <name>MCR_Broadcast_Main</name>
          <allow-fields>false</allow-fields>
        </ndi>
      </consumers>
    </channel>
  </channels>

  <controllers>
    <tcp>
      <port>5250</port>
      <protocol>AMCP</protocol>
    </tcp>
  </controllers>

  <amcp>
    <media-server>
      <host>localhost</host>
      <port>8000</port>
    </media-server>
  </amcp>

  <html>
    <remote-debugging-port>9222</remote-debugging-port>
    <enable-gpu>true</enable-gpu>
  </html>
</configuration>
